{
  "openapi": "3.0.0",
  "info": {
    "title": "Korean Tax Summary API (세금탈출)",
    "description": "AI-free, rule-based tax guidance and tag mapping for Korean individuals and businesses.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://taxescape.eieu5683.workers.dev",
      "description": "Production Worker"
    }
  ],
  "paths": {
    "/tax-tags": {
      "get": {
        "summary": "Search tax guides by tags or keywords",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Keyword to search (e.g., 프리랜서, 5월, 공제)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "count": { "type": "integer" },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "category": { "type": "string" },
                          "tags": { "type": "array", "items": { "type": "string" } },
                          "id": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tax-premium": {
      "get": {
        "summary": "Get high-value tax savings and refund tips (Premium Only)",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Keyword to search (e.g., 환급, 절세, 상속)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Premium tax tips and reference links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "count": { "type": "integer" },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "premium_tips": { "type": "string" },
                          "category": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
